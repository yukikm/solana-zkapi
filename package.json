{
  "name": "solana-zkapi",
  "private": true,
  "type": "module",
  "engines": { "node": "24.19.0", "npm": "11.9.0" },
  "workspaces": ["packages/sdk"],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/sdk/tsconfig.json",
