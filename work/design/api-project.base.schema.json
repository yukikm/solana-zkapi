{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zkapi.example/contracts/api-project.schema.json",
  "title": "Offline new-Devnet API registration project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "staging",
    "operator",
    "services"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "target": {
      "const": "devnet-new"
    },
    "staging": {
      "$ref": "#/$defs/pinnedFile"
    },
    "operator": {
      "$ref": "#/$defs/pinnedFile"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api",
          "priceMicroUsdc",
          "validFrom",
          "validUntil",
          "credentialFile"
        ],
        "properties": {
          "api": {
            "$ref": "#/$defs/apiBinding"
          },
          "priceMicroUsdc": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "validFrom": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "validUntil": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$"
          },
          "credentialFile": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          }
        }
      }
    }
  },
  "$defs": {
    "pinnedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "apiBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "service",
        "operation",
        "method",
        "origin",
        "path",
        "request_max_bytes",
        "response_max_bytes",
        "timeout_seconds",
        "billing"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "method": {
          "const": "POST"
        },
        "origin": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "request_max_bytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "response_max_bytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "timeout_seconds": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "billing": {
          "const": "http_2xx_json"
        }
      }
    }
  }
}
