      "priceMicroUsdc": "250",
      "validFrom": "REPLACE_WITH_UNIX_SECONDS",
      "validUntil": "REPLACE_WITH_UNIX_SECONDS",
      "credentialFile": "/REPLACE/private/weather-api-key"
    }
  ]
}
