{
  "schema": 1,
  "target": "devnet-new",
  "staging": {
    "path": "/REPLACE/private/staging.json",
    "sha256": "REPLACE_WITH_INDEPENDENT_SHA256"
  },
  "operator": {
    "path": "/REPLACE/private/operator.json",
    "sha256": "REPLACE_WITH_INDEPENDENT_SHA256"
  },
  "services": [
    {
      "api": {
        "version": "1",
        "service": "weather",
        "operation": "lookup",
        "method": "POST",
        "origin": "https://weather.example",
        "path": "/v1/current",
        "request_max_bytes": "4096",
        "response_max_bytes": "65536",
