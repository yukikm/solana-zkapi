# Private CloudFront VPC origin. Replace the reserved hostname with the exact
# Distribution.DomainName output before install; do not use a variable Host.
# Port 8080 ingress is restricted by the EC2 SG to the AWS-managed VPC-origin SG.
# TLS terminates at CloudFront; this private hop is HTTP as specified in CFN.
limit_req_zone $binary_remote_addr zone=zkapi_origin:10m rate=10r/s;
server {
    listen 8080 default_server;
    server_name _;
    client_max_body_size 64k;
    client_body_timeout 15s;
    access_log off;
    error_log /var/log/nginx/zkapi-error.log crit;
    limit_req zone=zkapi_origin burst=40 nodelay;
    limit_req_status 429;
    proxy_http_version 1.1;
    proxy_set_header Host replace-with-generated-host.cloudfront.net;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header Forwarded "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_next_upstream off;
    proxy_intercept_errors off;
    proxy_redirect off;
    proxy_buffering off;
    proxy_cache off;
    # Origin, Fetch Metadata, Authorization and exact AUTH invitation survive.
    # API route/method/body/credential/CORS checks remain in the gateway.
    location ^~ /zkapi/v1/ { proxy_pass http://127.0.0.1:4175; }
    location = /rpc { proxy_pass http://127.0.0.1:4175; }
    location = /relay-status { proxy_pass http://127.0.0.1:4175; }
    location = /provider-budget { proxy_pass http://127.0.0.1:4175; }
    location / { return 404; }
}
