[Unit]
Description=Durable Devnet challenger
RequiresMountsFor=/srv/zka
After=network-online.target zka-postgresql.service zka-control.service
Requires=zka-postgresql.service
Wants=zka-control.service

[Service]
Type=simple
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=~@debug
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=no
TimeoutStopSec=90
KillMode=control-group
User=zka-challenger
Group=zka-challenger
WorkingDirectory=/opt/zkapi
ExecStart=/opt/zkapi/bin/challengerd run /srv/zka/challenger/config.json
ReadWritePaths=/srv/zka/challenger

[Install]
WantedBy=multi-user.target
