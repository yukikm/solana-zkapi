# Include inside the existing private-origin server. Retain its original
# Host, timeout, logging and proxy retry settings and every financial route.
location ^~ /recovery/v1/ {
    limit_req zone=zkapi_recovery_api burst=100 nodelay;
    limit_req zone=zkapi_recovery_create burst=10 nodelay;
    limit_req_status 429;
    client_max_body_size 4m;
    client_body_timeout 15s;
    proxy_pass http://127.0.0.1:4176;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_next_upstream off;
    proxy_intercept_errors off;
    proxy_redirect off;
    access_log off;
}
